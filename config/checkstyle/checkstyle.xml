<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Javadoc everywhere (the author, 2026-11-21): every package, type, constructor, method and field of the main code
  carries a Javadoc comment, so the code stays readable in the future. Only Javadoc rules are checked here — the code
  style itself is the author's (AGENTS.md §9). Any finding fails the build (build.gradle: maxWarnings = 0).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <module name="JavadocPackage"/>
  <module name="TreeWalker">
    <module name="MissingJavadocType">
      <property name="scope" value="private"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="private"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <property name="minLineCount" value="-1"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <module name="JavadocVariable">
      <property name="accessModifiers" value="public, protected, package, private"/>
      <property name="ignoreNamePattern" value="serialVersionUID|log"/>
    </module>
    <module name="JavadocType">
      <property name="allowUnknownTags" value="false"/>
    </module>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public, protected, package, private"/>
      <property name="validateThrows" value="false"/>
    </module>
    <module name="SummaryJavadoc"/>
    <module name="InvalidJavadocPosition"/>
    <module name="NonEmptyAtclauseDescription"/>
  </module>
</module>
