# Line endings: the shell script stays LF, the Windows script CRLF; the wrapper jar is binary.
* text=auto
/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# The content source files are copied byte for byte and verified by SHA-256 (AGENTS.md §6.1, §6.2):
# Git must never change their bytes or line endings.
src/main/resources/content/** -text
